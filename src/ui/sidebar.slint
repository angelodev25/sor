import { ListMusicIcon, SearchIcon, SettingsIcon } from "@lucide";
import { SorLogo } from "logo.slint";

// Barra lateral de solo iconos para el modo ancho. Buscar/Ajustes son
// placeholder: solo cambian el resaltado, sin vista propia todavía.
component SideItem inherits Rectangle {
    callback picked(int);
    in property <int> idx: 0;
    in property <int> active: 0;

    height: 52px;
    background: transparent;

    HorizontalLayout {
        alignment: end;
        padding-right: 2px;
        if root.active == root.idx: Rectangle {
            width: 2px;
            background: #00e5ff;
        }
    }


    HorizontalLayout {
        alignment: center;
        @children
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(root.idx); }
    }
}

export component Sidebar inherits Rectangle {
    // Mismo índice que el Navbar (0=Reproduciendo, 1=Biblioteca, 2=Buscar, 3=Ajustes).
    callback nav-changed(int);
    in-out property <int> active-index: 1;

    width: 64px;
    background: #0a0d12;

    Rectangle {
        width: 1px;
        x: parent.width - 1px;
        background: #ffffff0a;
    }

    VerticalLayout {
        padding-top: 12px;
        spacing: 4px;
        alignment: start;

        SorLogo {}

        // Sin item de Reproducción: en modo ancho siempre está visible.
        SideItem {
            idx: 1;
            active: root.active-index;
            picked(i) => { root.nav-changed(i); }
            ListMusicIcon { size: 20px; colorize: root.active-index == 1 ? #00e5ff : #8f8f9c; vertical-alignment: center; y: (parent.height - self.height) / 2; }
        }

        SideItem {
            idx: 2;
            active: root.active-index;
            picked(i) => { root.nav-changed(i); }
            SearchIcon { size: 20px; colorize: root.active-index == 2 ? #00e5ff : #8f8f9c; vertical-alignment: center; y: (parent.height - self.height) / 2; }
        }

        SideItem {
            idx: 3;
            active: root.active-index;
            picked(i) => { root.nav-changed(i); }
            SettingsIcon { size: 20px; colorize: root.active-index == 3 ? #00e5ff : #8f8f9c; vertical-alignment: center; y: (parent.height - self.height) / 2; }
        }
    }
}
