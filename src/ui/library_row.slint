import { HeadphonesIcon } from "@lucide";

// Una fila del explorador: carátula a la izquierda, título + artista en
// letra ancha y debajo el nombre real del archivo en letra fina pequeña.
export component TrackRow inherits Rectangle {
    in property <string> track-title: "Título";
    in property <string> track-artist: "Artista";
    in property <image> cover;
    in property <bool> has-cover: false;
    in property <bool> is-selected: false;

    callback clicked();
    // Rueda: `dy` positivo = bajar la lista.
    callback scroll-down(dy: length);

    // 68px con la tarjeta a 64px: deja 2px de aire arriba/abajo (ListView
    // no tiene `spacing`).
    height: 68px;
    background: transparent;

    Rectangle {
        x: 0;
        y: 2px;
        width: parent.width;
        height: parent.height - 4px;
        border-radius: 10px;
        background: root.is-selected ? #1c2230 : transparent;

        HorizontalLayout {
            padding: 8px;
            spacing: 12px;

            // --- Carátula ---
            Rectangle {
                width: 48px;
                height: 48px;
                // A/B: la miniatura va sin alpha (diagnóstico), así que sale
                // cuadrada. El radio solo aplica al hueco sin portada.
                border-radius: root.has-cover ? 0px : 8px;
                // El gradiente solo si no hay portada: pintarlo bajo la imagen
                // era overdraw en cada fila visible y en cada frame de scroll.
                background: root.has-cover
                    ? transparent
                    : @linear-gradient(135deg, #1a2029, #2d3748);

                if root.has-cover: Image {
                    width: 100%;
                    height: 100%;
                    source: root.cover;
                }

                if !root.has-cover: VerticalLayout {
                    alignment: center;

                    HorizontalLayout {
                        alignment: center;

                        HeadphonesIcon {
                            size: 22px;
                            colorize: #ffffff50;
                        }
                    }
                }
            }

            // --- Textos ---
            VerticalLayout {
                alignment: center;
                spacing: 3px;

                Text {
                    text: root.track-title;
                    color: #f5f5fa;
                    font-size: 14px;
                    font-weight: 700;
                    overflow: elide;
                }

                Text {
                    text: root.track-artist;
                    color: #aab3c0;
                    font-size: 13px;
                    font-weight: 500;
                    overflow: elide;
                }
            }
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        // La rueda la lleva la propia fila: un TouchArea encima se quedaría
        // con el ratón (hace GrabMouse) y los clicks de las filas no llegarían.
        scroll-event(event) => {
            root.scroll-down(-event.delta-y);
            return accept;
        }
    }
}
