import { MusicIcon, ListMusicIcon, SearchIcon, SettingsIcon } from "@lucide";
import { SorLogo } from "logo.slint";

export component Navbar inherits Rectangle {
    // Callback que se dispara cuando el usuario clickea un item.
    // Recibe el indice (0=Reproduciendo, 1=Biblioteca, 2=Buscar, 3=Ajustes).
    callback nav-changed(int);
    // Item resaltado con la línea neón.
    in-out property <int> active-index: 0;

    height: 60px;
    background: #0a0d12;

    // Linea inferior sutil para separar visualmente del contenido.
    Rectangle {
        height: 1px;
        y: parent.height - 1px;
        background: #ffffff0a;
    }

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 4px;

        HorizontalLayout {
            alignment: start;
            SorLogo {}
        }

        // --- Item 1: Reproduciendo (ACTIVO) ---
        Rectangle {
            height: 60px;
            min-width: 150px;
            background: transparent;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;
                alignment: center;

                MusicIcon { size: 18px; colorize: root.active-index == 0 ? #00e5ff : #8f8f9c; vertical-alignment: center; y: (parent.height - self.height) / 2; }
                Text {
                    text: "Reproduciendo";
                    color: root.active-index == 0 ? #00e5ff : #8f8f9c;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            // Linea neon inferior que marca el activo.
            if root.active-index == 0: Rectangle {
                height: 2px;
                y: parent.height - 2px;
                background: #00e5ff;
            }

            TouchArea {
                clicked => { root.nav-changed(0); }
            }
        }

        // --- Item 2: Biblioteca ---
        Rectangle {
            height: 60px;
            min-width: 130px;
            background: transparent;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;
                alignment: center;

                ListMusicIcon { size: 18px; colorize: root.active-index == 1 ? #00e5ff : #8f8f9c; vertical-alignment: center; y: (parent.height - self.height) / 2; }
                Text {
                    text: "Biblioteca";
                    color: root.active-index == 1 ? #00e5ff : #8f8f9c;
                    font-size: 14px;
                    font-weight: root.active-index == 1 ? 600 : 400;
                    vertical-alignment: center;
                }
            }

            if root.active-index == 1: Rectangle {
                height: 2px;
                y: parent.height - 2px;
                background: #00e5ff;
            }

            TouchArea {
                clicked => { root.nav-changed(1); }
            }
        }

        // --- Item 3: Buscar ---
        Rectangle {
            height: 60px;
            min-width: 110px;
            background: transparent;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;
                alignment: center;

                SearchIcon { size: 18px; colorize: root.active-index == 2 ? #00e5ff : #8f8f9c; vertical-alignment: center; y: (parent.height - self.height) / 2; }
                Text {
                    text: "Buscar";
                    color: root.active-index == 2 ? #00e5ff : #8f8f9c;
                    font-size: 14px;
                    font-weight: root.active-index == 2 ? 600 : 400;
                    vertical-alignment: center;
                }
            }

            if root.active-index == 2: Rectangle {
                height: 2px;
                y: parent.height - 2px;
                background: #00e5ff;
            }

            TouchArea {
                clicked => { root.nav-changed(2); }
            }
        }

        // --- Item 4: Ajustes ---
        Rectangle {
            height: 60px;
            min-width: 120px;
            background: transparent;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;
                alignment: center;

                SettingsIcon { size: 18px; colorize: root.active-index == 3 ? #00e5ff : #8f8f9c; vertical-alignment: center; y: (parent.height - self.height) / 2; }
                Text {
                    text: "Ajustes";
                    color: root.active-index == 3 ? #00e5ff : #8f8f9c;
                    font-size: 14px;
                    font-weight: root.active-index == 3 ? 600 : 400;
                    vertical-alignment: center;
                }
            }

            if root.active-index == 3: Rectangle {
                height: 2px;
                y: parent.height - 2px;
                background: #00e5ff;
            }

            TouchArea {
                clicked => { root.nav-changed(3); }
            }
        }
    }
}
