import { MusicIcon, ListMusicIcon, SearchIcon, SettingsIcon } from "@lucide";

export component Navbar inherits Rectangle {
    // Callback que se dispara cuando el usuario clickea un item.
    // Recibe el indice (0=Reproduciendo, 1=Biblioteca, 2=Buscar, 3=Ajustes).
    callback nav-changed(int);

    height: 60px;
    background: #0a0d12;

    // Linea inferior sutil para separar visualmente del contenido.
    Rectangle {
        height: 1px;
        y: parent.height - 1px;
        background: #ffffff0a;
    }

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 4px;

        // Marca: isotipo neon + wordmark con jerarquia visual.
        HorizontalLayout {
            spacing: 9px;
            alignment: start;
            padding-right: 20px;

            VerticalLayout {
                alignment: center;
                spacing: 0px;

                Text {
                    text: "Sor";
                    color: #e5e5f9;
                    font-size: 21px;
                    font-weight: 800;
                    vertical-alignment: center;
                }

                Text {
                    text: "A U D I O";
                    color: #00bcd4;
                    font-size: 7px;
                    font-weight: 700;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }
        }

        // --- Item 1: Reproduciendo (ACTIVO) ---
        Rectangle {
            height: 60px;
            min-width: 150px;
            background: transparent;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;
                alignment: center;

                MusicIcon { size: 18px; colorize: #00e5ff; vertical-alignment: center; y: (parent.height - self.height) / 2; }
                Text {
                    text: "Reproduciendo";
                    color: #00e5ff;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            // Linea neon inferior que marca el activo.
            Rectangle {
                height: 2px;
                y: parent.height - 2px;
                background: #00e5ff;
            }

            TouchArea {
                clicked => { root.nav-changed(0); }
            }
        }

        // --- Item 2: Biblioteca ---
        Rectangle {
            height: 60px;
            min-width: 130px;
            background: transparent;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;
                alignment: center;

                ListMusicIcon { size: 18px; colorize: #8f8f9c; vertical-alignment: center; y: (parent.height - self.height) / 2; }
                Text {
                    text: "Biblioteca";
                    color: #8f8f9c;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => { root.nav-changed(1); }
            }
        }

        // --- Item 3: Buscar ---
        Rectangle {
            height: 60px;
            min-width: 110px;
            background: transparent;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;
                alignment: center;

                SearchIcon { size: 18px; colorize: #8f8f9c; vertical-alignment: center; y: (parent.height - self.height) / 2; }
                Text {
                    text: "Buscar";
                    color: #8f8f9c;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => { root.nav-changed(2); }
            }
        }

        // --- Item 4: Ajustes ---
        Rectangle {
            height: 60px;
            min-width: 120px;
            background: transparent;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;
                alignment: center;

                SettingsIcon { size: 18px; colorize: #8f8f9c; vertical-alignment: center; y: (parent.height - self.height) / 2; }
                Text {
                    text: "Ajustes";
                    color: #8f8f9c;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => { root.nav-changed(3); }
            }
        }
    }
}
