import { Navbar } from "navbar.slint";
import { Player } from "player.slint";
import { EqPanel } from "eq_panel.slint";

export component AppWindow inherits Window {
    title: "Sor";
    preferred-width: 1000px;
    preferred-height: 600px;
    min-width: 800px;
    min-height: 600px;
    background: #10151b;

    // ---- Estado global (lo que Rust controla directamente) ----
    in-out property <string> track-title: "Sin pista cargada";
    in-out property <string> track-artist: "Artista desconocido";
    in-out property <bool> is-playing: false;
    in-out property <bool> is-loading: false;
    in-out property <float> progress: 0;
    in-out property <string> elapsed-label: "00:00";
    in-out property <string> duration-label: "00:00";
    in-out property <image> cover;
    in-out property <bool> has-cover: false;

    // ---- Parametros del EQ, expuestos para que Rust los pueda tocar ----
    in-out property <float> eq-low-gain: 0;
    in-out property <float> eq-low-shelf: 0;
    in-out property <float> eq-low-resonance: 0;

    in-out property <float> eq-mid-gain: 0;
    in-out property <float> eq-mid-body: 0;
    in-out property <float> eq-mid-presence: 0;

    in-out property <float> eq-high-gain: 0;
    in-out property <float> eq-high-shelf: 0;
    in-out property <float> eq-high-air: 0;

    in-out property <float> eq-master-gain: 1.0;

    // limitador
    in-out property <float> eq-limiter-ceiling: 1.5;
    in-out property <bool> eq-limiter-enabled: true;
    in-out property <float> eq-volume: 1.0;
    in-out property <float> soft-clipping: 0.5;
    in-out property <bool> soft-clip-enabled: true;

    // ---- Eventos hacia Rust ----
    callback play-pause();
    callback eq-changed();
    callback limiter-changed();
    callback output-changed();

    VerticalLayout {
        // ---------- Navbar ----------
        Navbar {
            nav-changed(idx) => {
                // Por ahora, sin efecto. En el futuro, cambiara de vista.
            }
        }

        // ---------- Contenido: Player + EqPanel ----------
        HorizontalLayout {
            // El Player toma todo el espacio disponible.
            Player {
                horizontal-stretch: 1;
                track-title <=> root.track-title;
                track-artist <=> root.track-artist;
                is-playing  <=> root.is-playing;
                is-loading  <=> root.is-loading;
                progress <=> root.progress;
                elapsed-label <=> root.elapsed-label;
                duration-label <=> root.duration-label;
                cover <=> root.cover;
                has-cover <=> root.has-cover;
                play-pause => { root.play-pause(); }
            }

            // El EqPanel tiene ancho fijo. Al estar dentro del mismo
            // HorizontalLayout, su altura es automaticamente la misma
            // que la del Player (ambos llenan el alto disponible).
            EqPanel {
                min-width: 200px;
                max-width: 200px;
                horizontal-stretch: 0;

                // Conectamos las propiedades del EqPanel con las de AppWindow.
                low-gain       <=> root.eq-low-gain;
                low-shelf      <=> root.eq-low-shelf;
                low-resonance  <=> root.eq-low-resonance;

                mid-gain       <=> root.eq-mid-gain;
                mid-body       <=> root.eq-mid-body;
                mid-presence   <=> root.eq-mid-presence;

                high-gain      <=> root.eq-high-gain;
                high-shelf     <=> root.eq-high-shelf;
                high-air       <=> root.eq-high-air;

                drive    <=> root.eq-master-gain;

                limiter-ceiling <=> root.eq-limiter-ceiling;
                limiter-enabled <=> root.eq-limiter-enabled;

                volume <=> root.eq-volume;
                soft-clipping <=> root.soft-clipping;
                soft-clip-enabled   <=> root.soft-clip-enabled;
                
                output-changed => { root.output-changed(); }
                eq-changed => {root.eq-changed();}
                limiter-changed => {root.limiter-changed();}
            }
        }
    }
}