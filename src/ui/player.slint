import { Slider, ProgressIndicator } from "std-widgets.slint";
import { PlayIcon, PauseIcon, SkipBackIcon, SkipForwardIcon, HeadphonesIcon } from "@lucide";

// Boton circular con icono. El icono se pasa como hijo a traves de
// @children, porque en Slint los iconos de Lucide son componentes
// (no valores <image>), y no se pueden pasar como propiedad.

component IconButton inherits Rectangle {
    callback clicked();

    width: 58px;
    height: 58px;
    border-radius: 29px;
    background: #1c2230;

    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            alignment: center;
            @children
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}


export component Player inherits Rectangle {
    in-out property <string> track-title: "Sin pista cargada";
    in-out property <string> track-artist: "Artista desconocido";
    in-out property <bool> is-playing: false;
    in-out property <bool> is-loading: false;
    in-out property <float> progress: 0;
    in-out property <string> elapsed-label: "00:00";
    in-out property <string> duration-label: "00:00";
    in-out property <image> cover;
    in-out property <bool> has-cover: false;
    // Modo compacto para la columna derecha: menos aire, misma info.
    in property <bool> compact: false;

    callback play-pause();

    background: #10151b;

    VerticalLayout {
        alignment: center;
        spacing: root.compact ? 8px : 18px;
        padding: root.compact ? 6px : 32px;

        // --- Caratula centrada horizontalmente ---
        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: root.compact ? 160px : 260px;
                height: root.compact ? 160px : 260px;
                // Solo para el borde: el redondeo del contenido viene horneado
                // en el alpha de la imagen (el software renderer no soporta
                // `border-radius` + `clip`, y los gradientes de Slint lo ignoran).
                border-radius: 20px;
                background: transparent;
                border-width: 1px;
                border-color: #ffffff12;

                // Con portada es la carátula; sin ella, el hueco ya redondeado.
                Image {
                    width: 100%;
                    height: 100%;
                    source: root.cover;
                }

                if !root.has-cover: VerticalLayout {
                    alignment: center;

                    HorizontalLayout {
                        alignment: center;

                        HeadphonesIcon {
                            size: root.compact ? 48px : 90px;
                            colorize: #ffffff50;
                        }
                    }
                }
            }
        }

        // --- Titulo + artista ---
        VerticalLayout {
            spacing: 2px;
            alignment: center;

            Text {
                text: root.track-title;
                color: #f5f5fa;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: root.track-artist;
                color: #8f8f9c;
                font-size: 13px;
                horizontal-alignment: center;
            }
        }

        // --- Barra de progreso ---
        HorizontalLayout {
            spacing: 12px;
            alignment: center;

            // Slint no tiene operador `%` para aritmetica: `%` esta
            // reservado para unidades. Los textos los calcula Rust.
            Text {
                text: root.elapsed-label;
                color: #8f8f9c;
                font-size: 11px;
                vertical-alignment: center;
            }

            // `<=>` es binding bidireccional: el slider actualiza
            // `progress` al arrastrarlo, y `progress` mueve el slider
            // cuando se cambia desde fuera.
            Slider {
                min-width: 220px;
                horizontal-stretch: 1;
                minimum: 0;
                maximum: 1;
                value <=> root.progress;
            }

            Text {
                text: root.duration-label;
                color: #8f8f9c;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        
        // --- Controles ---
        HorizontalLayout {
            spacing: 15px;
            alignment: center;
            height: 58px;

            // Anterior
            Rectangle {
                width: 44px;
                height: 58px;
                background: transparent;

                VerticalLayout {
                    alignment: center;

                    IconButton {
                        width: 44px;
                        height: 44px;
                        clicked => { }

                        SkipBackIcon {
                            size: 18px;
                            colorize: #e8e8ee;
                        }
                    }
                }
            }

            // Reproducir / pausa: botón principal
            Rectangle {
                width: 58px;
                height: 58px;
                border-radius: 29px;
                background: root.is-loading ? #1c2230 :
                    root.is-playing ? #00e5ff : #1c2230;

                animate background { duration: 150ms; }

                VerticalLayout {
                    alignment: center;

                    HorizontalLayout {
                        alignment: center;

                        if root.is-loading : ProgressIndicator {
                            width: 24px;
                            height: 24px;
                        }

                        if !root.is-loading && root.is-playing : PauseIcon {
                            size: 22px;
                            colorize: #10151b;
                        }

                        if !root.is-loading && !root.is-playing : PlayIcon {
                            size: 22px;
                            colorize: #f5f5fa;
                        }
                    }
                }

                TouchArea {
                    clicked => {
                        if !root.is-loading {
                            root.play-pause();
                        }
                    }
                }
            }

            // Siguientes
            Rectangle {
                width: 44px;
                height: 58px;
                background: transparent;

                VerticalLayout {
                    alignment: center;

                    IconButton {
                        width: 44px;
                        height: 44px;
                        clicked => { }

                        SkipForwardIcon {
                            size: 18px;
                            colorize: #e8e8ee;
                        }
                    }
                }
            }
        }
    }
}